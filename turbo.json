{
    "$schema": "https://turbo.build/schema.json",
    "ui": "tui",
    "tasks": {
        "dev": {
            "cache": false,
            "persistent": true
        },
        "build": {
            "dependsOn": [
                "^build"
            ],
            "inputs": [
                "$TURBO_DEFAULT$",
                ".env*"
            ],
            "outputs": [
                ".astro/**",
                ".wrangler/**",
                "dist/**"
            ]
        },
        "deploy": {
            "dependsOn": [
                "build"
            ],
            "outputs": []
        }
    }
}